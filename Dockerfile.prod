# Production-optimized multi-stage build for DineProX ABP Framework application
FROM mcr.microsoft.com/dotnet/aspnet:9.0-alpine AS base
WORKDIR /app

# Install curl for health checks and ICU for globalization
RUN apk add --no-cache curl icu-libs

# Create non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

EXPOSE 80
EXPOSE 443

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0-alpine AS build
WORKDIR /src

# Install necessary build tools
RUN apk add --no-cache git

# Copy source code first
COPY . .

# Restore dependencies for production projects only
RUN dotnet restore "src/DineProX.HttpApi.Host/DineProX.HttpApi.Host.csproj" --verbosity quiet

# Build the application
WORKDIR "/src/src/DineProX.HttpApi.Host"
RUN dotnet build "DineProX.HttpApi.Host.csproj" -c Release -o /app/build --no-restore

# Publish stage
FROM build AS publish
RUN dotnet publish "DineProX.HttpApi.Host.csproj" -c Release -o /app/publish /p:UseAppHost=false --no-restore

# Runtime stage
FROM base AS final
WORKDIR /app

# Copy published application
COPY --from=publish /app/publish .

# Set ownership to non-root user
RUN chown -R appuser:appgroup /app

# Set environment variables
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:80
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

ENTRYPOINT ["dotnet", "DineProX.HttpApi.Host.dll"] 